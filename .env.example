# Database (local Postgres via `docker compose up -d`)
# Host port 55432 avoids clashing with other local Postgres/containers.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/dropshipping?schema=public"

# Better Auth — generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded admin login — created by `pnpm db:seed` (via Better Auth) and granted
# OWNER on the "demo" tenant. Dev-only defaults; the seed falls back to these
# if unset, so override them before seeding any shared/staging database.
SEED_ADMIN_NAME="Demo Admin"
SEED_ADMIN_EMAIL="admin@demo.test"
SEED_ADMIN_PASSWORD="changeit-dev-only"

# Public app URL (exposed to the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (optional until Phase 1 checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
