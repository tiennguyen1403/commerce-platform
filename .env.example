# Database (local Postgres via `docker compose up -d`)
# Host port 55432 avoids clashing with other local Postgres/containers.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/dropshipping?schema=public"

# Better Auth — generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded admin login — created by `pnpm db:seed` (via Better Auth) and granted
# OWNER on the "demo" tenant. Dev-only defaults; the seed falls back to these
# if unset, so override them before seeding any shared/staging database.
SEED_ADMIN_NAME="Demo Admin"
SEED_ADMIN_EMAIL="admin@demo.test"
SEED_ADMIN_PASSWORD="changeit-dev-only"

# Public app URL (exposed to the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — required for checkout (use test-mode keys from the Stripe dashboard).
# Secret + webhook-signing keys are server-only; the publishable key is exposed
# to the browser via NEXT_PUBLIC_* and must never hold a secret.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend — transactional email (order confirmation). OPTIONAL: leave both unset or
# blank and the app still boots and checkout still works — the confirmation email
# is simply skipped (logged, never fatal). Set both to enable sending. Get an API
# key at https://resend.com. In test mode you can send from `onboarding@resend.dev`
# to your own account's address; use a sender on a verified domain in production.
# EMAIL_FROM accepts a friendly name: "Acme Store <orders@acme.com>".
RESEND_API_KEY="re_..."
EMAIL_FROM="Acme Store <onboarding@resend.dev>"

# Error alerts — OPTIONAL. A Slack or Discord incoming-webhook URL. When set,
# reportError() POSTs a compact summary of each reported server error here, so
# alerts outlive Vercel Hobby's 1-hour log retention. Leave unset/blank to log
# only. Treat the URL as sensitive — anyone holding it can post to your channel.
ERROR_WEBHOOK_URL=""

# Printful — print-on-demand fulfillment (M4). OPTIONAL: leave unset or blank and
# the app boots and checkout works; the provider selector falls back to a deterministic
# mock in dev/test, and is "not configured" in production (submission surfaces a typed
# error, never a crash) — the RESEND_API_KEY posture. Set it to a Store-level Private
# Token to submit real orders. A store-level token needs only Bearer auth (no store id).
# One-time operator setup + a free draft smoke test: docs/milestones/M4-fulfillment/printful-setup.md.
PRINTFUL_API_KEY=""

# Fulfillment poll — OPTIONAL. How many days an order may sit SUBMITTED but un-shipped
# before the poll flags it as a STUCK open shipment for an operator to chase (M4 #155):
# a provider hold (onhold/inreview) that isn't resolving. Left unset (commented out, as
# below) it keeps the built-in 10-day default — a generous, still-provisional buffer over
# Printful's produce-and-ship window (tracking assigned at carrier handoff, up to ~a week).
# Uncomment and set a positive number of days to adjust without a deploy once real timing
# data exists. Server-only; a non-positive or non-numeric value fails boot.
# FULFILLMENT_STUCK_THRESHOLD_DAYS=10

# Cron harness — shared secret guarding the GET /api/cron/* routes (issue #53).
# The scheduled GitHub Actions workflow (.github/workflows/cron.yml) sends it as a
# Bearer token; Vercel Cron (vercel.json) attaches the same header automatically
# when CRON_SECRET is set on the deployment. Generate one with: openssl rand -hex 32.
# Deliberately NOT validated in src/lib/env.ts — a missing/blank value just 401s
# the cron routes (fail-closed), it never blocks boot or the rest of the app. Safe
# to leave blank locally unless you're exercising the cron endpoints by hand.
CRON_SECRET=""
