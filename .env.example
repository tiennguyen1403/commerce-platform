# Database (local Postgres via `docker compose up -d`)
# Host port 55432 avoids clashing with other local Postgres/containers.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/dropshipping?schema=public"

# Better Auth — generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-hex-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Seeded admin login — created by `pnpm db:seed` (via Better Auth) and granted
# OWNER on the "demo" tenant. Dev-only defaults; the seed falls back to these
# if unset, so override them before seeding any shared/staging database.
SEED_ADMIN_NAME="Demo Admin"
SEED_ADMIN_EMAIL="admin@demo.test"
SEED_ADMIN_PASSWORD="changeit-dev-only"

# Public app URL (exposed to the browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — required for checkout (use test-mode keys from the Stripe dashboard).
# Secret + webhook-signing keys are server-only; the publishable key is exposed
# to the browser via NEXT_PUBLIC_* and must never hold a secret.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Resend — transactional email (order confirmation). OPTIONAL: leave both unset or
# blank and the app still boots and checkout still works — the confirmation email
# is simply skipped (logged, never fatal). Set both to enable sending. Get an API
# key at https://resend.com. In test mode you can send from `onboarding@resend.dev`
# to your own account's address; use a sender on a verified domain in production.
# EMAIL_FROM accepts a friendly name: "Acme Store <orders@acme.com>".
RESEND_API_KEY="re_..."
EMAIL_FROM="Acme Store <onboarding@resend.dev>"

# Error alerts — OPTIONAL. A Slack or Discord incoming-webhook URL. When set,
# reportError() POSTs a compact summary of each reported server error here, so
# alerts outlive Vercel Hobby's 1-hour log retention. Leave unset/blank to log
# only. Treat the URL as sensitive — anyone holding it can post to your channel.
ERROR_WEBHOOK_URL=""
