// Prisma schema — multi-tenant e-commerce platform
// Every business table carries `tenantId`; repositories always scope by it so
// one store can never read another store's data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & access control
// ---------------------------------------------------------------------------

/// One store = one tenant.
model Tenant {
  id   String @id @default(cuid())
  slug String @unique
  name String
  // The store's single currency (ISO 4217, lowercase — Stripe's convention).
  // Every variant price and order total is in this currency; the catalog has no
  // per-variant currency, so a cart/order can never mix currencies. One store =
  // one currency (M1 is single-tenant; a store-settings editor is a follow-up).
  currency  String   @default("usd")
  // Per-tenant storefront accent: an OKLCH hue angle (0–359°) fed to the scoped
  // theme in `(storefront)/layout.tsx` (see src/lib/theme.ts). Defaults to the
  // platform emerald (162°, see globals.css / docs/DESIGN.md), so an existing
  // store is a visual no-op. NOT NULL + DEFAULT keeps the migration safe on
  // non-empty tables (docs/DATABASE.md migration guard).
  themeHue  Int      @default(162)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  products       Product[]
  orders         Order[]
  outboxMessages OutboxMessage[]
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

/// Links a user to a tenant with a role (RBAC).
model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(STAFF)
  userId    String
  tenantId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core models)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  // A shopper's orders across the platform (each row stays tenant-scoped by its
  // own `Order.tenantId`). Back-relation for `Order.user`; nullable there, so a
  // User may have none, and `onDelete: SetNull` keeps their orders if the
  // account is ever removed (the order de-links to a guest, never cascades).
  orders      Order[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id String @id
  // Better Auth 1.7 scopes account identity by `issuer`; the (issuer,
  // accountId) pair is unique. Required to match the installed adapter's writes.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Full-text search vector (#105). A Postgres STORED generated column — the
  // database recomputes `setweight(to_tsvector(title),'A') ‖
  // setweight(to_tsvector(description),'B')` on every write, never Prisma. The
  // real DDL (the column and its GIN index) is hand-authored in the migration,
  // because a Prisma model can't express GENERATED/tsvector. This field mirrors
  // that column in the exact form `prisma db pull` emits — `Unsupported` +
  // `@default(dbgenerated(...))`, with `@@index(..., type: Gin)` below — so the
  // schema matches the DB and `migrate` proposes no drift. Prisma omits it from
  // the generated client's selects and writes (Unsupported + DB-generated), so
  // `searchActiveByTenant` reaches it through a parameterized `$queryRaw`
  // (`@@ websearch_to_tsquery`) served by the GIN index. See docs/DATABASE.md.
  searchVector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'B'::\"char\"))"))

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  // GIN index over the generated `searchVector` (created in the migration); the
  // search query rides it. Declared here in `prisma db pull`'s form so the
  // schema and DB agree and no spurious drop-index migration is ever generated.
  @@index([searchVector], type: Gin)
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String
  name       String
  // Maps our free-form `sku` to the fulfillment provider's opaque catalog
  // variant id (e.g. Printful's integer `variant_id`). Provider-agnostic name
  // (not `printfulVariantId`) so the provider stays swappable behind the
  // `FulfillmentProvider` interface. Nullable: an unmapped variant simply isn't
  // submittable — the submission service treats an unmapped line as a defined,
  // admin-visible failure, never a silent provider 4xx (M4 #134).
  providerVariantId String?
  // Money is stored as integer minor units (cents) to avoid float errors. The
  // currency is the store's (`Tenant.currency`), never per-variant — that's what
  // keeps a cart/order total single-currency and soundly summable.
  priceCents Int
  // Physical units on hand — what the admin types. Sellable stock is
  // `available = stock - reserved`, never `stock` alone.
  stock Int @default(0)
  // Units held by in-flight (PENDING) orders: bumped when an order is created,
  // released on CANCELLED/sweep, and released again when the sale reconciles at
  // PAID (as `stock` drops by the same amount). A running counter — kept as an
  // atomically-maintained cache of the Order/OrderItem ledger — so the sellable
  // check is a single-row read, not an aggregate over every open order. Floored
  // at 0 on release; the storefront shows/clamps to `stock - reserved`.
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

/// Lifecycle of an order's fulfillment — our own closed state machine, distinct
/// from the raw provider status string (`Order.fulfillmentProviderStatus`, admin
/// display only). Shape mirrors `OutboxStatus`: NOT_SUBMITTED is the initial
/// state, SUBMITTING/SUBMITTED are the live states, SHIPPED and FAILED are
/// terminal. SUBMITTING doubles as the order-level idempotency guard for
/// provider submission — a duplicate POD order is real money + a physical
/// shipment, so a lost worker leaves the order stuck in SUBMITTING for a human
/// to reconcile rather than silently retrying (M4 research, "Idempotent
/// submission"). Set only by the fulfillment service + poll cron in later M4
/// issues; this migration only lays the column.
enum FulfillmentStatus {
  NOT_SUBMITTED // PAID with no address yet, or not yet claimed by the outbox
  SUBMITTING // claimed for submission — the order-level idempotency guard
  SUBMITTED // provider accepted the order; no tracking yet
  SHIPPED // provider reports shipped — drives Order.status → FULFILLED
  FAILED // provider rejected it (soft failure) or submit attempts exhausted
}

model Order {
  id                    String      @id @default(cuid())
  tenantId              String
  orderNumber           String
  status                OrderStatus @default(PENDING)
  email                 String
  // The signed-in shopper who placed this order, or null for a guest checkout.
  // Identity is platform-wide (the global `User`), but the order stays
  // tenant-scoped by `tenantId` regardless. Resolved server-side from the
  // session at checkout — never client-supplied (#102). `onDelete: SetNull` (see
  // the relation below) keeps a paid order's history intact if the account is
  // later deleted: it de-links to a guest row rather than cascading away.
  userId                String?
  totalCents            Int
  currency              String      @default("usd")
  stripePaymentIntentId String?     @unique
  // Set true — in the SAME transaction as the PENDING → PAID flip — when the
  // atomic stock decrement couldn't fully allocate one or more lines (an oversell
  // captured at payment: the units were sold but weren't on hand). A durable cue
  // for the admin order view (manual refund/review) and the confirmation email's
  // copy (#40). The payment still stands PAID; only inventory fell short. One-way:
  // nothing clears it. Set by `markPaidByPaymentIntent`.
  oversold              Boolean     @default(false)
  // Shipping address, flattened onto the order (not a separate Address model) to
  // match the OrderItem snapshot philosophy — a point-in-time fact later catalog
  // or account edits must never rewrite — and to avoid a join on every order read
  // (admin detail, shopper history, the fulfillment-outbox re-read). All
  // nullable: a guest/legacy order, or one placed before M4, simply has none.
  // Written in the SAME transaction as order creation at checkout (M4 #134).
  shipName              String?
  shipLine1             String?
  shipLine2             String?     // optional second line (apt/suite/unit)
  shipCity              String?
  shipState             String?     // state/province/region — requiredness varies by country
  shipPostalCode        String?
  shipCountry           String?     // ISO-3166 alpha-2, from the SHIPPING_COUNTRIES allowlist
  // Fulfillment + tracking, written as a PAID order moves through the provider
  // (POD) lifecycle; all nullable or defaulted so existing PAID/FULFILLED rows
  // backfill safely (golden rule 6). Populated by the submission service and the
  // poll-fulfillment cron in later M4 issues — this migration only lays them.
  // Which provider handled the order ("printful" | "mock"); provider-agnostic so
  // a swap is a data change, not a schema change. Null until first submitted.
  fulfillmentProvider   String?
  // The provider's own order id (FulfillmentResult.externalId), persisted on a
  // successful submission so the poll cron can reconcile tracking against it.
  fulfillmentExternalId String?
  // Our own closed fulfillment state (see FulfillmentStatus). NOT NULL with a
  // DEFAULT so existing rows backfill to NOT_SUBMITTED (migration-safe).
  fulfillmentStatus     FulfillmentStatus @default(NOT_SUBMITTED)
  // The raw, free-form status string from the provider (Printful: "draft",
  // "pending", "inprocess", "fulfilled", …) — admin display only, never a
  // control-flow input (that role belongs to fulfillmentStatus, our closed enum).
  fulfillmentProviderStatus String?
  // Shipment tracking, persisted by the poll cron once the provider reports a
  // shipment (null until then): carrier + number identify the parcel; url is the
  // provider-supplied tracking link surfaced in the account UI + shipping email.
  trackingCarrier       String?
  trackingNumber        String?
  trackingUrl           String?
  // When the poll-fulfillment cron first surfaced this order as a STUCK open
  // shipment — SUBMITTED + un-shipped past the age threshold (a provider hold like
  // Printful `onhold`/`inreview` that isn't resolving; M4 #155). Its job is
  // idempotency: the operator alert fires only while this is null, so a stuck order
  // is surfaced ONCE, not on every ~10-minute cron tick. Deliberately the inverse of
  // #151's terminal-fail exit — setting it does NOT change `fulfillmentStatus`: the
  // order stays SUBMITTED and keeps being polled, because an onhold order can still
  // ship. Null for every normally-progressing order (SHIPPED long before the
  // threshold). Nullable, no default → safe to add on non-empty tables (golden rule 6).
  fulfillmentStuckAt    DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Nullable link to the global shopper account. SetNull (not Cascade) so
  // deleting a User never deletes their orders — the order de-links to a guest.
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  outboxMessages OutboxMessage[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  // Admin orders list (`listByTenant`): newest-first within a tenant, optionally
  // status-filtered. Composite so the tenant scope + `createdAt` ordering is
  // index-served, not a sort over the tenant's whole order history.
  @@index([tenantId, createdAt])
  // A signed-in shopper's order history within one store (`listByTenantAndUser`,
  // #92): tenant-scoped first (golden rule 1), then by shopper, newest-first — so
  // the history read is index-served, not a scan+sort. Tenant-leading like the
  // other Order indexes; the `userId` it also covers is null for guest orders.
  @@index([tenantId, userId, createdAt])
  // Abandoned-PENDING sweep (`findStalePending`, #25): the platform-wide cron
  // selects PENDING orders older than a grace window, oldest first, ACROSS all
  // tenants — so it can't use the tenant-scoped index above. Composite [status,
  // createdAt] serves the `status = 'PENDING'` filter + `createdAt` ordering
  // directly (mirrors the outbox's [status, nextAttemptAt] drain index).
  @@index([status, createdAt])
  // Poll-fulfillment cron work list (`findSubmittedForPolling`, #140/#158): the
  // platform-wide `{fulfillmentStatus: 'SUBMITTED', status: 'PAID'}` scan. Serves the
  // two-equality filter — the dominant cost as the SUBMITTED set grows with
  // accumulating provider holds, the exact scenario #158 addresses (the method's own
  // doc comment had flagged this as the natural follow-up "if that set ever grows").
  // `fulfillmentStatus` leads both because SUBMITTED is transient and low-cardinality
  // (a selective first term) and — the stronger reason — for non-redundancy with the
  // `[status, createdAt]` index above: a `status`-leading composite would overlap it,
  // whereas for this two-equality predicate the index seek localises equally whichever
  // term leads. The residual `fulfillmentStuckAt NULLS FIRST, createdAt` ordering (#158
  // deprioritises flagged-stuck rows to the tail) runs as a cheap sort over the small
  // filtered set — Prisma can't express NULLS FIRST in an index (only the runtime
  // `orderBy` can), and the filtered set is small, so covering the sort isn't worth it.
  @@index([fulfillmentStatus, status])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  variantId     String
  // Snapshot title/price at purchase time so later catalog edits don't rewrite history.
  titleSnapshot String
  priceCents    Int
  quantity      Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Transactional outbox (reliable email delivery — #30)
// ---------------------------------------------------------------------------

/// Lifecycle of an outbox message. Retry state is a PENDING row with a future
/// `nextAttemptAt` (no separate FAILED status) so "due to send" is a single,
/// uniform query. PENDING and SENDING are the only live states; SENT and DEAD
/// are terminal.
enum OutboxStatus {
  PENDING // awaiting send, or backing off until `nextAttemptAt`
  SENDING // claimed by a drain run, in flight (reclaimed if the claim goes stale)
  SENT // delivered — terminal
  DEAD // permanently failed: retries exhausted or a permanent error — terminal
}

/// What kind of message this row renders to. The discriminator lets the drain
/// dispatch by type — its `sendMessage` switch is exhaustive, so adding a value
/// here without a matching case is a compile error — and keeps the table a
/// genuine outbox rather than a single-purpose queue.
enum OutboxMessageType {
  ORDER_CONFIRMATION // a paid order's confirmation email (#30)
  FULFILLMENT_SUBMISSION // submit a PAID order to the POD provider (M4 #134)
  SHIPPING_CONFIRMATION // the shipped + tracking email once fulfillment ships (M4 #134)
}

/// A durable "please send this" record, written **in the same transaction** as
/// the business event it follows (the order's PENDING → PAID flip), so a paid
/// order can never exist without its confirmation being queued. The cron drain
/// (`/api/cron/dispatch-outbox`) sends pending rows with backoff, turning
/// delivery from at-most-once (the old synchronous webhook send) into
/// at-least-once. Tenant-scoped like every business table.
model OutboxMessage {
  id       String            @id @default(cuid())
  tenantId String
  type     OutboxMessageType
  // The order this message renders from. The email content is already
  // snapshotted on the order (titleSnapshot/priceCents), so the drain re-reads
  // the order at send time instead of duplicating a rendered payload here.
  orderId  String
  // Stable, unique key — also passed to Resend as its `Idempotency-Key` so a
  // send that succeeds but whose row update is then lost (a killed worker) is
  // de-duplicated by Resend on the next attempt (24h window). Derived from the
  // order id, so the single in-transaction enqueue can never write two.
  idempotencyKey String       @unique
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  // When the row next becomes eligible to send. Defaults to now (send asap);
  // a failed attempt pushes it into the future (exponential backoff).
  nextAttemptAt DateTime  @default(now())
  // When the current SENDING claim was taken — lets a later run reclaim a claim
  // abandoned by a crashed/killed worker. Null whenever the row is not SENDING.
  claimedAt DateTime?
  // Last failure text, for observability only — never drives control flow.
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The drain's hot path: "PENDING rows whose nextAttemptAt has arrived".
  @@index([status, nextAttemptAt])
  @@index([tenantId])
  @@index([orderId])
}
